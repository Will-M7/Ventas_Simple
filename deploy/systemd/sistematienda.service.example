[Unit]
Description=Sistematienda local API
After=network.target

[Service]
Type=simple
User=tienda
WorkingDirectory=/opt/sistematienda/backend
EnvironmentFile=/opt/sistematienda/backend/.env
ExecStart=/usr/bin/node /opt/sistematienda/backend/dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
