# Desarrollo aislado. Producción debe usar rutas absolutas a sus datos existentes.
NODE_ENV=development
PORT=3000
JWT_SECRET=
DATA_DIR=./data-dev
UPLOAD_DIR=./uploads-dev
BUSINESS_TIME_ZONE=America/Lima
BACKUP_DIR=./backups-dev
BACKUP_RETENTION_COUNT=14
# Solo se usan cuando users está vacía; no se recrean usuarios en reinicios.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_PASSWORD=
# Nunca habilitar en producción. No hacen falta para iniciar el servidor.
ALLOW_DESTRUCTIVE_DB_RESET=false
ALLOW_DEMO_SEED=false
